{
  "id": "amenity-reservations",
  "contexts": ["household", "shared_space"],
  "name": "Amenity Reservations",
  "version": "1.1.0",
  "description": "Reserve shared facilities — pool, clubhouse, courts, BBQ. Board configures amenities, booking windows, usage limits, and approval requirements.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["amenities", "reservations", "booking", "hoa", "facilities"],
  "icon": "🏊",
  "storage": "db",
  "preload": {
    "settings": {"sql": "SELECT value FROM app_amenity_reservations__settings WHERE key = 'board_group_id' LIMIT 1"},
    "reviews": {"sql": "SELECT v.reservation_id, v.decision, v.reviewed_by, v.reviewed_at FROM app_amenity_reservations__reviews v JOIN app_amenity_reservations__reservations r ON r.id = v.reservation_id AND r.date >= date(?, '-30 days')", "params": [":today"]},
    "reservations": {"sql": "SELECT * FROM app_amenity_reservations__reservations WHERE date >= date(?, '-30 days') ORDER BY date, start_time", "params": [":today"]},
    "amenities": {"sql": "SELECT * FROM app_amenity_reservations__amenities ORDER BY name"}
  },
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "db_plaintext_columns": ["decision", "date", "start_time", "end_time", "visibility", "name"],
  "admin_config": {
    "settings_table": "settings",
    "keys": ["board_group_id"]
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_amenity_reservations__reservations WHERE reserved_by = :me AND date >= :today AND status IN ('confirmed', 'pending') LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "reservations coming up",
      "severity": "info"
    }
  },
  "publishes": [
    "amenity.reserved"
  ],
  "publish_acls": {
    "amenity.reserved": { "require_role": "member" }
  },
  "row_policies": {
    "reservations": {
      "kind": "owner_or_visibility",
      "member_column": "reserved_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }],
      "max_per_member": {
        "member_column": "reserved_by",
        "scope_columns": ["amenity_id", { "column": "date", "transform": "month" }],
        "limit": 30
      }
    },
    "reviews": {
      "kind": "inherit_visibility",
      "fk_column": "reservation_id",
      "parent_table": "reservations",
      "writer_column": "reviewed_by",
      "insert_privileged_only": true
    },
    "amenities": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "insert_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "settings": {
      "kind": "app_config"
    }
  },
  "agenda": {
    "kind": "event",
    "label": "Amenities",
    "source": {
      "kind": "sql",
      "query": "SELECT r.id AS id, a.name AS title, r.date || 'T' || r.start_time AS when_at, r.start_time || '–' || r.end_time AS subtitle, r.reserved_by AS member_id FROM app_amenity_reservations__reservations r JOIN app_amenity_reservations__amenities a ON a.id = r.amenity_id WHERE r.date = :today AND r.status IN ('confirmed', 'pending') ORDER BY r.start_time LIMIT 20"
    }
  },
  "member_references": {
    "amenities": { "column": "created_by", "on_removed": "keep" },
    "reservations": [
      {
        "column": "reserved_by",
        "on_removed": "delete",
        "dependent_tables": [
          {
            "table": "reviews",
            "foreign_key": "reservation_id"
          }
        ]
      },
      { "column": "reviewed_by", "on_removed": "keep" }
    ],
    "reviews": { "column": "reviewed_by", "on_removed": "keep" }
  },
  "resource_limits": { "max_db_bytes": 52428800 },
  "nav": { "label": "Amenities" },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_reservations", "amenity_availability"]
  }
}

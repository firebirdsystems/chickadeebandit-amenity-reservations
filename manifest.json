{
  "id": "amenity-reservations",
  "contexts": ["household", "shared_space"],
  "name": "Amenity Reservations",
  "version": "1.0.0",
  "description": "Reserve shared facilities — pool, clubhouse, courts, BBQ. Board configures amenities, booking windows, usage limits, and approval requirements.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["amenities", "reservations", "booking", "hoa", "facilities"],
  "icon": "🏊",
  "storage": "db",
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "db_plaintext_columns": ["decision", "date", "start_time", "end_time", "visibility"],
  "admin_config": {
    "settings_table": "settings",
    "keys": ["board_group_id"]
  },
  "row_policies": {
    "reservations": {
      "kind": "owner_or_visibility",
      "member_column": "reserved_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }],
      "max_per_member": {
        "member_column": "reserved_by",
        "scope_columns": ["amenity_id", { "column": "date", "transform": "month" }],
        "limit": 30
      }
    },
    "reviews": {
      "kind": "inherit_visibility",
      "fk_column": "reservation_id",
      "parent_table": "reservations",
      "writer_column": "reviewed_by",
      "insert_privileged_only": true
    },
    "amenities": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "insert_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "board_group_id" }]
    },
    "settings": {
      "kind": "app_config"
    }
  },
  "nav": { "label": "Amenities" },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_reservations", "amenity_availability"]
  }
}
